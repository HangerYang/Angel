+class LlamaAttentionQKNorm(LlamaAttention):
+    """LlamaAttention + per-head RMSNorm on Q and K before RoPE.
+
+    Mirrors the training-side draft attention (`qk_norm: true` in the draft
+    config); the extra weights load as `self_attn.q_norm/k_norm.weight`.
+    """
+
+    def __init__(self, config: LlamaConfig, *args, **kwargs) -> None:
+        super().__init__(config, *args, **kwargs)
+        eps = getattr(config, "rms_norm_eps", 1e-6)
+        self.q_norm = RMSNorm(self.head_dim, eps=eps)
+        self.k_norm = RMSNorm(self.head_dim, eps=eps)
+
+    def forward(
+        self,
+        positions: torch.Tensor,
+        hidden_states: torch.Tensor,
+    ) -> torch.Tensor:
+        qkv, _ = self.qkv_proj(hidden_states)
+        q, k, v = qkv.split([self.q_size, self.kv_size, self.kv_size], dim=-1)
+        q_by_head = q.view(*q.shape[:-1], q.shape[-1] // self.head_dim, self.head_dim)
+        q = self.q_norm(q_by_head).view(q.shape)
+        k_by_head = k.view(*k.shape[:-1], k.shape[-1] // self.head_dim, self.head_dim)
+        k = self.k_norm(k_by_head).view(k.shape)
+        q, k = self.rotary_emb(positions, q, k)
+        attn_output = self.attn(q, k, v)
+        output, _ = self.o_proj(attn_output)
+        return output
+
+
