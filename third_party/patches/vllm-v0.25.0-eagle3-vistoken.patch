+    def _maybe_load_vistoken(self, device: torch.device):
+        """Load the trained row compressor out of the draft checkpoint.
+
+        Kept out of vLLM's weight loader on purpose: the module is imported
+        from AngelSlim, so training and decode run the *same* code, and the
+        vLLM diff stays confined to this file.
+        """
+        import os as _os
+
+        cfg_dict = getattr(self.draft_model_config.hf_config, "vistoken_compress", None)
+        if not cfg_dict:
+            return None
+        if _os.environ.get("VLLM_EAGLE_VISTOKEN", "1").strip().lower() in (
+            "0", "false", "no", "off",
+        ):
+            logger.info("vistoken: disabled by VLLM_EAGLE_VISTOKEN=0")
+            return None
+        from angelslim.compressor.vistoken.row_compressor import (
+            VisRowCompressor,
+            VisRowCompressorConfig,
+        )
+        from safetensors.torch import load_file
+
+        hf_cfg = self.draft_model_config.hf_config
+        opts = dict(cfg_dict)
+        opts.setdefault("hidden_size", hf_cfg.hidden_size)
+        aux_ids = getattr(hf_cfg, "aux_hidden_states_layer_ids", None) or []
+        opts.setdefault("num_streams", len(aux_ids) or 3)
+        if "stream_bands" in opts:
+            opts["stream_bands"] = tuple(tuple(b) for b in opts["stream_bands"])
+        elif opts.get("routing") == "per_band":
+            bands, off = [], 0
+            for band in getattr(hf_cfg, "eagle_aux_layer_bands", ()) or ():
+                bands.append(tuple(range(off, off + len(band))))
+                off += len(band)
+            opts["stream_bands"] = tuple(bands)
+        module = VisRowCompressor(VisRowCompressorConfig(**opts))
+
+        model_dir = self.draft_model_config.model
+        state, found = {}, False
+        for name in ("model.safetensors",):
+            path = _os.path.join(model_dir, name)
+            if _os.path.exists(path):
+                for k, v in load_file(path).items():
+                    if k.startswith("vistoken."):
+                        state[k[len("vistoken.") :]] = v
+                        found = True
+        if not found:
+            raise RuntimeError(
+                f"config declares vistoken_compress but {model_dir} has no "
+                "vistoken.* weights -- wrong checkpoint?"
+            )
+        missing, unexpected = module.load_state_dict(state, strict=False)
+        if missing or unexpected:
+            raise RuntimeError(
+                f"vistoken weight mismatch: missing={missing} unexpected={unexpected}"
+            )
+        module = module.to(device=device, dtype=self.dtype).eval()
+        for p in module.parameters():
+            p.requires_grad_(False)
+        self._vistoken_image_token_id = int(getattr(hf_cfg, "image_token_id", 49190))
+        self._vistoken_tile_tokens = int(module.cfg.tile_tokens)
+        self._vistoken_offsets = torch.as_tensor(module.offsets, device=device)
+        # The compact prefill IS the compression here: run the whole draft
+        # stack on the kept rows, which is what HIVIS_ALL already implements.
+        _os.environ["VLLM_EAGLE_HIVIS_ALL"] = "1"
+        logger.info(
+            "vistoken: %d rows/tile at slots %s, %d aux streams; compact draft "
+            "prefill armed",
+            module.cfg.num_queries,
+            module.offsets,
+            module.cfg.num_streams,
+        )
+        return module
+
+    @torch.no_grad()
+    def _maybe_compress_visual_rows(self, input_batch, aux_concat: torch.Tensor):
+        """Write each tile's k summaries into its fixed slots, in place.
+
+        ``aux_concat`` is [num_tokens, n_streams*H], the raw aux streams before
+        the band mix -- compression over positions and the mix over layers
+        commute, so this is the same order training uses.
+        """
+        self._vistoken_keep = None
+        if self._vistoken is None:
+            return
+        num_tokens = int(input_batch.num_tokens)
+        if num_tokens <= 1:
+            return  # decode: every row is a drafted text token
+        ids = input_batch.input_ids[:num_tokens]
+        img_pos = ids.eq(self._vistoken_image_token_id).nonzero().flatten()
+        tile = self._vistoken_tile_tokens
+        if img_pos.numel() == 0 or img_pos.numel() % tile != 0:
+            if img_pos.numel():
+                logger.warning(
+                    "vistoken: %d image rows is not a multiple of %d; leaving "
+                    "this prompt uncompressed",
+                    img_pos.numel(),
+                    tile,
+                )
+            return
+        tiles = img_pos.view(-1, tile)
+        if not bool(torch.all(tiles[:, 1:] - tiles[:, :-1] == 1).item()):
+            logger.warning("vistoken: image rows not contiguous; leaving uncompressed")
+            return
+
+        n_tiles = tiles.shape[0]
+        tile_hs = aux_concat[tiles].unsqueeze(0)               # [1, T, 64, n*H]
+        out, _ = self._vistoken(tile_hs.to(self._vistoken.ref_mix_logits.dtype), n_tiles)
+        slots = tiles.index_select(1, self._vistoken_offsets).reshape(-1)
+        aux_concat[slots] = out[0].reshape(slots.numel(), -1).to(aux_concat.dtype)
+
+        keep = torch.ones(num_tokens, dtype=torch.bool, device=aux_concat.device)
+        keep[tiles.reshape(-1)] = False
+        keep[slots] = True
+        self._vistoken_keep = keep
+
