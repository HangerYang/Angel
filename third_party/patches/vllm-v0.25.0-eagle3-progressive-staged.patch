+        if not outs:
+            return None
+        gathered: list[torch.Tensor] = []
+        for h in outs:
+            if token_indices is not None:
+                gathered.append(h[token_indices])
+            elif num_tokens is not None:
+                gathered.append(h[:num_tokens])
+            else:
+                gathered.append(h)
+        self.model.set_aux_inject(gathered)
+        return gathered[0]
