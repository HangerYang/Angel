@@ -0,0 +1,378 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""AngelSlim Eagle miracle mode: oracle GT target-HS along a trajectory.
+
+Offline eval:
+  1) Target-only generate → GT token ids (saved under MIRACLE_HS_DIR)
+  2) Eagle phase=capture: walk GT path, record verify aux at absolute positions
+  3) Eagle phase=use: draft injects tape[pos]
+       step 0  = train unroll 0 (GT aux all layers; L0 seed = tape chunk 0)
+       steps 1+ = train warmup: L1/L2 (hawk also L0 inject) from tape;
+                  progressive L0 keeps last draft residual (h2), not GT chunk 0
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+from pathlib import Path
+from typing import Any
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_PHASE = "off"  # off | capture | use
+_DIR: Path | None = None
+_GT: list[dict[str, Any]] = []
+_TAPES: list[torch.Tensor | None] = []  # each [T, N, H]; GPU in USE after prefetch
+_REQ_TO_IDX: dict[str, int] = {}
+_LAST_RAW_CHUNKS: list[torch.Tensor] | None = None
+_PREFETCHED_KEY: tuple[str, str] | None = None
+# Offline LLM.chat / generate request ids look like "{prompt_index}-{hex}".
+_REQ_IDX_RE = re.compile(r"^(\d+)[-_]")
+
+
+def _truthy(val: str | None) -> bool:
+    return (val or "").strip().lower() in ("1", "true", "yes", "on")
+
+
+def init_from_env() -> None:
+    """Call once from draft model __init__."""
+    global _PHASE, _DIR, _GT, _TAPES, _REQ_TO_IDX, _PREFETCHED_KEY
+    enabled = _truthy(os.environ.get("VLLM_EAGLE_MIRACLE_MODE")) or _truthy(
+        os.environ.get("VLLM_EAGLE_ASSISTANCE_MODE")  # back-compat alias
+    )
+    if not enabled:
+        _PHASE = "off"
+        return
+    d = os.environ.get("VLLM_EAGLE_MIRACLE_HS_DIR", "").strip()
+    if not d:
+        logger.warning(
+            "Eagle miracle mode enabled but VLLM_EAGLE_MIRACLE_HS_DIR is empty"
+        )
+        _PHASE = "off"
+        return
+    _DIR = Path(d)
+    _DIR.mkdir(parents=True, exist_ok=True)
+    phase = os.environ.get("VLLM_EAGLE_MIRACLE_PHASE", "use").strip().lower()
+    if phase not in ("capture", "use"):
+        phase = "use"
+    _PHASE = phase
+    _REQ_TO_IDX = {}
+    _PREFETCHED_KEY = None
+    meta_path = _DIR / "gt_tokens.json"
+    if meta_path.is_file():
+        _GT = json.loads(meta_path.read_text(encoding="utf-8"))
+    else:
+        _GT = []
+    _TAPES = [None] * len(_GT)
+    if _PHASE == "use":
+        loaded = 0
+        for i in range(len(_GT)):
+            p = _DIR / f"{i:05d}.pt"
+            if p.is_file():
+                _TAPES[i] = torch.load(p, map_location="cpu", weights_only=True)
+                loaded += 1
+        logger.info(
+            "Eagle miracle USE: loaded %s/%s GT-HS tapes from %s",
+            loaded,
+            len(_GT),
+            _DIR,
+        )
+    else:
+        logger.info(
+            "Eagle miracle CAPTURE: will record GT-HS tapes for %s samples into %s",
+            len(_GT),
+            _DIR,
+        )
+
+
+def is_enabled() -> bool:
+    return _PHASE in ("capture", "use")
+
+
+def is_capture() -> bool:
+    return _PHASE == "capture"
+
+
+def is_use() -> bool:
+    return _PHASE == "use"
+
+
+def set_last_raw_chunks(chunks: list[torch.Tensor] | None) -> None:
+    global _LAST_RAW_CHUNKS
+    _LAST_RAW_CHUNKS = chunks
+
+
+def bind_req(req_id: str) -> int | None:
+    """Map engine req_id → GT sample index.
+
+    Do **not** use a sequential counter: warmup / internal requests would steal
+    slots and real prompts then miss the tape (seen as
+    ``more requests than GT samples`` + rotary shape crashes in use phase).
+
+    Offline ``LLM.chat`` ids are ``{prompt_index}-{hex}``; parse that index.
+    Warmup ids (``*_prefill_*`` / ``*_decode_*``) do not match and are skipped.
+    """
+    if not is_enabled() or not _GT:
+        return None
+    if req_id in _REQ_TO_IDX:
+        return _REQ_TO_IDX[req_id]
+    m = _REQ_IDX_RE.match(str(req_id))
+    if m is None:
+        return None
+    idx = int(m.group(1))
+    if idx < 0 or idx >= len(_GT):
+        logger.warning(
+            "Miracle: req_id=%s → sample %s out of range (n_gt=%s)",
+            req_id,
+            idx,
+            len(_GT),
+        )
+        return None
+    _REQ_TO_IDX[req_id] = idx
+    return idx
+
+
+def gt_token_at(sample_idx: int, abs_pos: int) -> int | None:
+    """Return GT token id at absolute position, or None."""
+    if sample_idx < 0 or sample_idx >= len(_GT):
+        return None
+    ids = _GT[sample_idx]["token_ids"]
+    if abs_pos < 0 or abs_pos >= len(ids):
+        return None
+    return int(ids[abs_pos])
+
+
+def record_verify_aux(
+    req_ids: list[str],
+    positions: torch.Tensor,
+    num_tokens: int,
+) -> None:
+    """During capture: write raw aux rows into the sample tape at abs positions."""
+    if not is_capture() or not _LAST_RAW_CHUNKS:
+        return
+    chunks = _LAST_RAW_CHUNKS
+    n = len(chunks)
+    # Offline miracle requires max_num_seqs=1 (one active req).
+    req_id = req_ids[0] if req_ids else None
+    if req_id is None:
+        return
+    idx = bind_req(req_id)
+    if idx is None:
+        return
+    h = chunks[0].shape[-1]
+    device = chunks[0].device
+    dtype = chunks[0].dtype
+    # Ensure tape long enough
+    max_pos = int(positions[:num_tokens].max().item()) if num_tokens > 0 else -1
+    need_t = max_pos + 1
+    tape = _TAPES[idx]
+    if tape is None or tape.shape[0] < need_t:
+        new_t = max(need_t, len(_GT[idx]["token_ids"]))
+        new_tape = torch.zeros(new_t, n, h, dtype=dtype, device="cpu")
+        if tape is not None:
+            new_tape[: tape.shape[0]] = tape
+        tape = new_tape
+        _TAPES[idx] = tape
+    pos_list = [int(positions[t].item()) for t in range(num_tokens)]
+    wrote = 0
+    for t in range(num_tokens):
+        pos = pos_list[t]
+        if pos < 0 or pos >= tape.shape[0]:
+            continue
+        if t >= chunks[0].shape[0]:
+            logger.warning(
+                "Miracle capture: chunk rows=%s < num_tokens=%s (req=%s)",
+                chunks[0].shape[0],
+                num_tokens,
+                req_id,
+            )
+            break
+        row = torch.stack([chunks[j][t].detach().to("cpu") for j in range(n)], dim=0)
+        tape[pos] = row
+        wrote += 1
+    if os.environ.get("VLLM_EAGLE_MIRACLE_DEBUG", "").strip() in (
+        "1",
+        "true",
+        "yes",
+        "on",
+    ):
+        logger.info(
+            "Miracle capture record: req=%s idx=%s n_tok=%s wrote=%s "
+            "pos_range=[%s,%s] chunk0=%s",
+            req_id,
+            idx,
+            num_tokens,
+            wrote,
+            min(pos_list) if pos_list else None,
+            max(pos_list) if pos_list else None,
+            tuple(chunks[0].shape),
+        )
+    # Persist incrementally so a crash mid-capture still leaves usable tapes.
+    if _DIR is not None and tape is not None:
+        torch.save(tape, _DIR / f"{idx:05d}.pt")
+
+
+def prefetch_tapes(device: torch.device, dtype: torch.dtype) -> None:
+    """Move USE tapes to ``device`` once (LLM dummy run, before the timer)."""
+    global _PREFETCHED_KEY
+    if not is_use():
+        return
+    key = (str(device), str(dtype))
+    if _PREFETCHED_KEY == key:
+        return
+    n = 0
+    for i, tape in enumerate(_TAPES):
+        if tape is None:
+            continue
+        if tape.device != device or tape.dtype != dtype:
+            _TAPES[i] = tape.to(device=device, dtype=dtype)
+        n += 1
+    _PREFETCHED_KEY = key
+    if n:
+        logger.info(
+            "Eagle miracle USE: prefetched %s tapes to %s %s", n, device, dtype
+        )
+
+
+def save_tapes() -> int:
+    """Persist captured tapes to MIRACLE_HS_DIR. Returns number saved."""
+    if _DIR is None:
+        return 0
+    n_saved = 0
+    for i, tape in enumerate(_TAPES):
+        if tape is None:
+            continue
+        torch.save(tape, _DIR / f"{i:05d}.pt")
+        n_saved += 1
+    logger.info("Eagle miracle CAPTURE: saved %s tapes to %s", n_saved, _DIR)
+    return n_saved
+
+
+def _gather_tape(
+    sample_idx: int,
+    positions: torch.Tensor,
+    dtype: torch.dtype,
+) -> torch.Tensor | None:
+    """Index tape[sample] at ``positions`` → ``[T, N, H]`` without CPU syncs."""
+    if sample_idx < 0 or sample_idx >= len(_TAPES) or _TAPES[sample_idx] is None:
+        return None
+    tape = _TAPES[sample_idx]
+    assert tape is not None
+    if tape.shape[0] == 0 or positions.numel() == 0:
+        return None
+    device = positions.device
+    if tape.device != device or tape.dtype != dtype:
+        tape = tape.to(device=device, dtype=dtype)
+        _TAPES[sample_idx] = tape
+    pos = positions.reshape(-1).to(dtype=torch.long)
+    pos = pos.clamp(0, tape.shape[0] - 1)
+    return tape.index_select(0, pos)
+
+
+def apply_miracle_window(
+    model: Any,
+    positions: torch.Tensor,
+    req_ids: list[str],
+    num_tokens: int,
+    combine_fn,
+) -> torch.Tensor | None:
+    """USE step-0: replace the full verify-window inject with tape[pos].
+
+    Matches train unroll 0 / ``acc_0``: at every position t, inject target
+    aux[t] (not live-verify alone, and never draft feedback). Offline miracle
+    is ``max_num_seqs=1``, so the window belongs to ``req_ids[0]``.
+    """
+    if not is_use() or num_tokens <= 0 or not req_ids:
+        return None
+    idx = bind_req(req_ids[0])
+    if idx is None:
+        return None
+    per_layer = bool(getattr(model, "per_layer_aux", False))
+    draft_dtype = next(model.parameters()).dtype
+    stacked = _gather_tape(idx, positions[:num_tokens], draft_dtype)
+    if stacked is None:
+        return None
+    n = stacked.shape[1]
+    if per_layer:
+        gathered = [stacked[:, j, :] for j in range(n)]  # each [T, H]
+        model.set_aux_inject(gathered)
+        return gathered[0]
+    flat = stacked.reshape(stacked.shape[0], -1)  # [T, N*H]
+    return combine_fn(flat)
+
+
+def apply_miracle_hs(
+    model: Any,
+    positions: torch.Tensor,
+    req_ids: list[str],
+    combine_fn,
+    seed_l0: bool = True,
+) -> tuple[torch.Tensor | None, bool]:
+    """Use-phase decode step: set injects from tape[pos].
+
+    ``positions`` is [num_reqs] absolute positions of the current draft token.
+
+    Progressive/hawk warmup eval: ``seed_l0=False`` so L1/L2 (hawk also L0
+    inject) get GT tape while the caller keeps last draft residual as L0 seed.
+    Fused Eagle3 keeps ``seed_l0=True`` (FC of GT aux is the only L0 input).
+
+    Returns ``(l0_seed_or_none, applied)``.
+    """
+    if not is_use():
+        return None, False
+    num_reqs = int(positions.shape[0])
+    if num_reqs <= 0 or not req_ids:
+        return None, False
+    per_layer = bool(getattr(model, "per_layer_aux", False))
+    draft_dtype = next(model.parameters()).dtype
+    rows: list[torch.Tensor] = []
+    for i in range(num_reqs):
+        req_id = req_ids[i] if i < len(req_ids) else None
+        if req_id is None:
+            return None, False
+        idx = bind_req(req_id)
+        if idx is None:
+            return None, False
+        row = _gather_tape(idx, positions[i : i + 1], draft_dtype)
+        if row is None:
+            return None, False
+        rows.append(row)  # [1, N, H]
+    stacked = torch.cat(rows, dim=0)  # [R, N, H]
+    n = stacked.shape[1]
+    if per_layer:
+        gathered = [stacked[:, j, :] for j in range(n)]
+        model.set_aux_inject(gathered)
+        if not seed_l0:
+            return None, True
+        return gathered[0], True
+    flat = stacked.reshape(num_reqs, -1)
+    return combine_fn(flat), True
+
+
+def force_gt_draft_tokens(
+    draft_tokens_col: torch.Tensor,
+    positions: torch.Tensor,
+    req_ids: list[str],
+) -> None:
+    """Capture-phase: overwrite sampled draft tokens with GT next tokens."""
+    if not is_capture():
+        return
+    num_reqs = positions.shape[0]
+    for i in range(num_reqs):
+        req_id = req_ids[i] if i < len(req_ids) else None
+        if req_id is None:
+            continue
+        idx = bind_req(req_id)
+        if idx is None:
+            continue
+        pos = int(positions[i].item())
+        tok = gt_token_at(idx, pos + 1)
+        if tok is not None:
+            draft_tokens_col[i] = tok
+
