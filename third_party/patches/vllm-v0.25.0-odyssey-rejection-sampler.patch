+def _odyssey_mod():
+    """Import Odyssey lazily and only when asked for.
+
+    Odyssey is a research tree outside the vllm package; a hard import would
+    make third_party/vllm depend on it.
+    """
+    import importlib
+    import sys
+
+    root = os.environ.get("ODYSSEY_ROOT")
+    if root and root not in sys.path:
+        sys.path.insert(0, root)
+    return importlib.import_module("odyssey.sampler_hook")
+
+
+def _odyssey_branch():
+    if not os.environ.get("ODYSSEY_BRANCH", "").strip():
+        return None
+    return _odyssey_mod().branch()
+
+
+def _odyssey_rejection_sample(*args, **kwargs):
+    return _odyssey_mod().odyssey_rejection_sample(*args, **kwargs)
+
