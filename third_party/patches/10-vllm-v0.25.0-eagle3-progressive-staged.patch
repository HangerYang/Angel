@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Tiny opt-in latency logger for AngelSlim EAGLE debugging."""
+
+from __future__ import annotations
+
+import json
+import os
+import time
+from contextlib import contextmanager
+from typing import Any, Iterator
+
+
+def enabled() -> bool:
+    return os.environ.get("ANGELSLIM_EAGLE_LATENCY", "").strip().lower() in {
+        "1",
+        "true",
+        "yes",
+        "on",
+    }
+
+
+def _sync() -> None:
+    try:
+        import torch
+
+        if torch.cuda.is_available():
+            torch.cuda.synchronize()
+    except Exception:
+        pass
+
+
+@contextmanager
+def time_block(name: str, **meta: Any) -> Iterator[None]:
+    if not enabled():
+        yield
+        return
+    _sync()
+    t0 = time.perf_counter()
+    try:
+        yield
+    finally:
+        _sync()
+        rec = {
+            "event": name,
+            "ms": (time.perf_counter() - t0) * 1000.0,
+            "pid": os.getpid(),
+            **meta,
+        }
+        print("[ANGELSLIM_EAGLE_LATENCY] " + json.dumps(rec, sort_keys=True), flush=True)
