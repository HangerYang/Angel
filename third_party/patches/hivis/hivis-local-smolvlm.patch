diff --git a/hivis/ge_data/ge_data_smolvlm.py b/hivis/ge_data/ge_data_smolvlm.py
new file mode 100644
index 0000000..032180d
--- /dev/null
+++ b/hivis/ge_data/ge_data_smolvlm.py
@@ -0,0 +1,187 @@
+"""Generate SmolVLM hidden-state data for official HiViS training.
+
+This keeps the upstream HiViS .ckpt contract:
+  - input_ids: compact language-token ids
+  - target: final target hidden states aligned with input_ids
+  - loss_mask: assistant-token supervision mask
+
+The target VLM sees the full image+text prompt. For multimodal samples, visual
+image tokens are removed from the saved drafter sequence, matching HiViS.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+from pathlib import Path
+
+DEFAULT_MODEL_PATH = "HuggingFaceTB/SmolVLM-256M-Instruct"
+DEFAULT_DATA_FILE = "/home/hyang/AngelSlim/dataset/smolvlm_256m_target_gen_mixed_70k70k/train.jsonl"
+IMAGE_TOKEN_ID = 49190
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--data-type", choices=("text", "multimodal"), required=True)
+    parser.add_argument("--start", type=int, default=0)
+    parser.add_argument("--end", type=int, default=10**12)
+    parser.add_argument("--index", type=int, default=0)
+    parser.add_argument("--gpu-index", "--gpu_index", dest="gpu_index", type=int, nargs="+", default=[0])
+    parser.add_argument("--outdir", type=Path, default=None)
+    parser.add_argument("--model-path", default=DEFAULT_MODEL_PATH)
+    parser.add_argument("--data-file", default=DEFAULT_DATA_FILE)
+    parser.add_argument("--image-root", type=Path, default=None, help="Accepted for allocation.py compatibility; unused for data URLs/absolute paths.")
+    parser.add_argument("--max-length", type=int, default=4096)
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--num-workers", type=int, default=1)
+    parser.add_argument("--fail-fast", action="store_true")
+    parser.add_argument("--min-loss-tokens", type=int, default=1)
+    args = parser.parse_args()
+    if args.start < 0 or args.end < args.start:
+        parser.error("require 0 <= --start <= --end")
+    if args.outdir is None:
+        dataset_name = "sharegpt" if args.data_type == "text" else "llava_v1_5_mix665k"
+        args.outdir = Path("eval_data/generated/smolvlm_256m") / dataset_name
+    return args
+
+
+args = parse_args()
+os.environ["CUDA_VISIBLE_DEVICES"] = ",".join(map(str, args.gpu_index))
+
+# CUDA visibility must be configured before importing torch/transformers.
+import torch
+from datasets import Features, Value, load_dataset
+from torch.utils.data import DataLoader
+from tqdm import tqdm
+from transformers import AutoModelForImageTextToText, AutoProcessor
+
+from angelslim.compressor.speculative.train.data.chat_templates import ChatTemplateType
+from angelslim.compressor.speculative.train.data.dataset_builder.online_dataset_builder import (
+    OnlineSmolVLMDatasetBuilder,
+)
+
+
+def has_image(record):
+    for turn in record.get("conversations") or []:
+        content = turn.get("content")
+        if not isinstance(content, list):
+            continue
+        for item in content:
+            if not isinstance(item, dict):
+                continue
+            if item.get("type") in {"image", "image_url"}:
+                return True
+            if item.get("image") or item.get("image_url"):
+                return True
+    return False
+
+
+def load_records():
+    features = Features(
+        {
+            "id": Value("string"),
+            "conversations": [
+                {
+                    "role": Value("string"),
+                    "content": [
+                        {
+                            "type": Value("string"),
+                            "text": Value("string"),
+                            "image": Value("string"),
+                            "image_url": {"url": Value("string")},
+                        }
+                    ],
+                }
+            ],
+        }
+    )
+    ds = load_dataset("json", data_files=args.data_file, features=features, split="train")
+    ds = ds.shuffle(seed=args.seed)
+    want_images = args.data_type == "multimodal"
+    ds = ds.filter(lambda row: has_image(row) == want_images, num_proc=args.num_workers)
+    end = min(args.end, len(ds))
+    if args.start >= end:
+        return ds.select(range(0, 0))
+    return ds.select(range(args.start, end))
+
+
+@torch.no_grad()
+def generate_sample(batch):
+    input_ids = batch["input_ids"].to(model.device)
+    attention_mask = batch["attention_mask"].to(model.device)
+    forward_kwargs = {"input_ids": input_ids, "attention_mask": attention_mask, "output_hidden_states": True}
+    if "pixel_values" in batch:
+        forward_kwargs["pixel_values"] = batch["pixel_values"].to(model.device)
+    if "pixel_attention_mask" in batch:
+        forward_kwargs["pixel_attention_mask"] = batch["pixel_attention_mask"].to(model.device)
+
+    outputs = model(**forward_kwargs)
+    target = outputs.hidden_states[-1]
+    loss_mask = batch["loss_mask"].to(model.device)
+
+    seq_len = int(attention_mask[0].long().sum().item())
+    keep = torch.zeros_like(input_ids[0], dtype=torch.bool)
+    keep[:seq_len] = True
+    if args.data_type == "multimodal":
+        keep = keep & (input_ids[0] != IMAGE_TOKEN_ID)
+
+    if int(keep.sum().item()) == 0:
+        return None
+
+    compact_loss_mask = loss_mask[0][keep].detach().cpu()
+    if int(compact_loss_mask.sum().item()) < args.min_loss_tokens:
+        return None
+
+    return {
+        "loss_mask": compact_loss_mask,
+        "input_ids": input_ids[0][keep].detach().cpu(),
+        "target": target[0][keep].detach().cpu(),
+    }
+
+
+def save_sample(output_dir: Path, sample, sample_index: int):
+    torch.save(sample, output_dir / f"data_{sample_index}.ckpt")
+
+
+processor = AutoProcessor.from_pretrained(args.model_path, trust_remote_code=True)
+model = AutoModelForImageTextToText.from_pretrained(
+    args.model_path,
+    torch_dtype=torch.bfloat16,
+    device_map="auto",
+    trust_remote_code=True,
+)
+model.eval()
+
+builder = OnlineSmolVLMDatasetBuilder(
+    tokenizer=processor,
+    max_length=args.max_length,
+    shuffle_seed=args.seed,
+    chat_template_type=ChatTemplateType.SMOLVLM,
+)
+collator = builder.get_data_collator()
+records = load_records()
+
+if args.data_type == "text":
+    output_dir = args.outdir / "non_code" / str(args.index)
+else:
+    output_dir = args.outdir / str(args.index)
+output_dir.mkdir(parents=True, exist_ok=True)
+
+loader = DataLoader(records, batch_size=1, shuffle=False, num_workers=0, collate_fn=lambda rows: rows[0])
+next_sample_index = len(list(output_dir.glob("data_*.ckpt")))
+for absolute_offset, record in enumerate(tqdm(loader, desc=f"smolvlm {args.data_type} ckpt")):
+    torch.cuda.empty_cache()
+    try:
+        processed = builder._process_single_conversation(record["conversations"])
+        if processed is None:
+            continue
+        batch = collator([processed])
+        sample = generate_sample(batch)
+        if sample is not None:
+            save_sample(output_dir, sample, next_sample_index)
+            next_sample_index += 1
+    except Exception as error:
+        absolute_index = args.start + absolute_offset
+        if args.fail_fast:
+            raise
+        tqdm.write(f"Skipping dataset index {absolute_index}: {error}")
