+def _compute_default_rope_parameters(config, device=None, seq_len=None, **kwargs):
+    """Standard RoPE inv_freq. transformers>=5 dropped the ``default`` registry key;
+    Qwen2.5-VL ``mrope`` uses the same frequencies with 3-D position ids."""
+    base = getattr(config, "rope_theta", 10000.0)
+    head_dim = getattr(config, "head_dim", None)
+    if head_dim is None:
+        head_dim = config.hidden_size // config.num_attention_heads
+    dim = int(head_dim * getattr(config, "partial_rotary_factor", 1.0))
+    inv_freq = 1.0 / (
+        base
+        ** (
+            torch.arange(0, dim, 2, dtype=torch.int64).to(device=device, dtype=torch.float32)
+            / dim
+        )
+    )
+    return inv_freq, 1.0
+
+
+def resolve_rope_init_fn(rope_type):
+    if rope_type in ROPE_INIT_FUNCTIONS:
+        return ROPE_INIT_FUNCTIONS[rope_type]
+    return _compute_default_rope_parameters
+
+
+# transformers>=5 dropped these keys; HiViS Qwen2.5-VL still requests them.
+ROPE_INIT_FUNCTIONS.setdefault("default", _compute_default_rope_parameters)
+ROPE_INIT_FUNCTIONS.setdefault("mrope", _compute_default_rope_parameters)
